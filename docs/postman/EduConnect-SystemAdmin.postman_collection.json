    {
      "name": "2. Add / switch on and off",
      "item": [
        {
          "name": "Create school",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data && body.data.school) { pm.environment.set('schoolId', body.data.school.schoolId); pm.environment.set('schoolName', body.data.school.schoolName); }",
                  "if (body.data && body.data.temporaryPassword) console.log('Temporary admin password (shown once):', body.data.temporaryPassword);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schoolName\": \"Greenfield Academy\",\n  \"email\": \"head@greenfield.example\",\n  \"phone\": \"08031234567\",\n  \"address\": \"12 Marina Road, Lagos\",\n  \"principalName\": \"Mrs Ada Obi\",\n  \"subscriptionTier\": \"basic\",\n  \"adminUserData\": {\n    \"firstName\": \"Ada\",\n    \"lastName\": \"Obi\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/schools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "schools"
              ]
            },
            "description": "Leave password out and one is generated and returned once as data.temporaryPassword. The new school code and name are saved to the environment."
          },
          "response": []
        },
        {
          "name": "Deactivate school",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Subscription unpaid for 60 days\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/schools/{{schoolId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "schools",
                "{{schoolId}}",
                "deactivate"
              ]
            },
            "description": "Locks everyone in the school out within ~30 seconds. Data is kept."
          },
          "response": []
        },
        {
          "name": "Reactivate school",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Paid in full\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/schools/{{schoolId}}/reactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "schools",
                "{{schoolId}}",
                "reactivate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Deactivate / activate a user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"deactivate\",\n  \"reason\": \"Left the school at the end of term\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/users/{{userId}}/access",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "users",
                "{{userId}}",
                "access"
              ]
            },
            "description": "action: activate | deactivate | change_role (newRole) | transfer_school (schoolTransfer.targetSchoolId)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Remove a school (archive or soft delete)",
      "item": [
        {
          "name": "Archive school (reversible)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Contract ended in July\",\n  \"confirmSchoolName\": \"{{schoolName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/schools/{{schoolId}}/archive",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "schools",
                "{{schoolId}}",
                "archive"
              ]
            },
            "description": "Locks everyone out, keeps all data. confirmSchoolName must match the school name."
          },
          "response": []
        },
        {
          "name": "Restore school",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Paid the outstanding invoice\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/schools/{{schoolId}}/restore",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "schools",
                "{{schoolId}}",
                "restore"
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE school (soft delete, restorable)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{systemAdminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"School closed permanently\",\n  \"confirmSchoolName\": \"{{schoolName}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/schools/{{schoolId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "schools",
                "{{schoolId}}"
              ]
            },
            "description": "Sets isDeleted and locks the school. Nothing is erased; POST /restore undoes it."
          },
          "response": []
        }
      ]
    },
