{
  "info": {
    "name": "EduConnect - System Admin (God Mode)",
    "description": "School operations for the platform owner: oversee, create, deactivate/reactivate, archive/delete/restore schools, remove people, import students and staff from CSV.\n\nImport EduConnect-SystemAdmin.postman_environment.json, select it, run \"Login\", then set schoolId (e.g. ABC1234).\n\nDestructive requests (archive, delete, remove) need a reason; archive and delete also need confirmSchoolName to match the school name exactly.\n\nSee docs/superadmin-god-mode.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Login",
      "item": [
        {
          "name": "Login (saves the token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.success && body.data && body.data.token) pm.environment.set('systemAdminToken', body.data.token);",
                  "pm.test('got a token', () => pm.expect(body.data.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{systemAdminEmail}}\",\n  \"password\": \"{{systemAdminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/system-admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "system-admin",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
