                  "key": "schoolId",
                  "value": "{{schoolId}}"
                },
                {
                  "key": "action",
                  "value": "",
                  "description": "e.g. school.archive, user.remove, import.students",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          },
          "response": []
