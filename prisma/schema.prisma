
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String           @id @default(uuid())
  schoolId             String
  email                String
  password             String
  isTemporaryPassword  Boolean          @default(false)
  firstName            String
  lastName             String
  role                 UserRole
  phone                String?
  address              String?
  profileImage         String?
  occupation           String?
  emergencyContact     String?
  emergencyPhone       String?
  isSchoolAdmin        Boolean          @default(false)
  subjects             String[]
  classes              String[]
  isActive             Boolean          @default(true)
  deactivatedAt        DateTime?
  deactivatedBy        String?
  deactivationReason   String?
  isVerified           Boolean          @default(false)
  invitationToken      String?
  invitationExpires    DateTime?
  invitedBy            String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  lastLogin            DateTime?
  lastLoginAt          DateTime?
  settings             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  armClasses           Arm[]               @relation("ArmClassTeacher")
  grades               Grade[]             @relation("GradeTeacher")
  parentStudents       ParentStudent[]     @relation("ParentStudents")
  teacherStudents      TeacherStudent[]    @relation("TeacherStudents")
  school               School              @relation(fields: [schoolId], references: [id])
  attendanceSessions   AttendanceSession[] @relation("AttendanceSessionCreator")
  attendanceRecords    AttendanceRecord[]  @relation("AttendanceMarker")
  feeStructures        FeeStructure[]      @relation("FeeStructureCreator")
  feeInvoices          FeeInvoice[]        @relation("FeeInvoiceCreator")
  feePayments          FeePayment[]        @relation("FeePaymentReceiver")
  scoreSheets          ScoreSheet[]        @relation("TeacherScoreSheets")
  studentProfile       Student?
  teacherPolicies      AssessmentPolicy[]   @relation("TeacherCreatedPolicies")
  policyPermissions    TeacherPolicyPermission[] @relation("TeacherPermission")
  grantedPermissions   TeacherPolicyPermission[] @relation("GrantedByAdmin")

  @@unique([schoolId, email])
  @@index([schoolId, role])
  @@map("users")
}

model School {
  id                   String             @id @default(uuid())
  schoolId             String             @unique
  schoolName           String
  email                String             @unique
  password             String
  address              String?
  phone                String?
  website              String?
  description          String?
  schoolType           String?
  adminUserId          String?
  isVerified           Boolean            @default(false)
  verificationOTP      String?
  otpExpires           DateTime?
  isActive             Boolean            @default(true)
  systemConfig         Json?
  systemMetadata       Json?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  users                User[]
  students             Student[]
  classes              Class[]
  subjects             Subject[]
  arms                 Arm[]
  grades               Grade[]
  auditLogs            PlatformAuditLog[]
  academicYears        AcademicYear[]
  academicTerms        AcademicTerm[]
  calendarEvents       SchoolCalendar[]
  attendanceSessions   AttendanceSession[]
  feeStructures        FeeStructure[]
  feePayments          FeePayment[]
  feeInvoices          FeeInvoice[]
  
  assessmentPolicies    AssessmentPolicy[]
  scoreSheets           ScoreSheet[]
  gradingScales         GradingScale[]      @relation("SchoolGradingScales")
  defaultGradingScaleId String? @unique
  defaultGradingScale  GradingScale?       @relation("DefaultGradingScale", fields: [defaultGradingScaleId], references: [id])

  @@index([schoolId])
  @@index([email])
  @@map("schools")
}

model GradingScale {
  id            String      @id @default(uuid())
  schoolId      String
  name          String
  description   String?
  isDefault     Boolean     @default(false)
  bands         GradeBand[]
  school             School      @relation("SchoolGradingScales", fields: [schoolId], references: [id])
  defaultForSchool   School?     @relation("DefaultGradingScale")
  createdAt          DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("grading_scales")
}

model GradeBand {
  id             String       @id @default(uuid())
  gradingScaleId String
  label          String
  minPercent     Float
  maxPercent     Float
  gradePoints    Float?
  description    String?
  gradingScale   GradingScale @relation(fields: [gradingScaleId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([gradingScaleId, label])
  @@index([gradingScaleId])
  @@map("grade_bands")
}

model Student {
  id                 String           @id @default(uuid())
  schoolId           String
  userId             String?          @unique
  studentId          String?
  firstName          String
  lastName           String
  email              String?
  section            String?
  rollNumber         String?
  grade              String?
  dateOfBirth        DateTime?
  gender             Gender?
  address            String?
  phone              String?
  profileImage       String?
  currentClass       String?
  academicYear       String?
  guardian           Json?
  isActive           Boolean          @default(true)
  isEnrolled         Boolean          @default(true)
  deactivatedAt      DateTime?
  deactivatedBy      String?
  deactivationReason String?
  admissionDate      DateTime?        @default(now())
  notes              String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  armId              String?
  classId            String?
  grades             Grade[]
  parentOf           ParentStudent[]  @relation("StudentParents")
  arm                Arm?             @relation("ArmStudents", fields: [armId], references: [id])
  classRef           Class?           @relation("StudentClass", fields: [classId], references: [id])
  school             School           @relation(fields: [schoolId], references: [id])
  studentOf          TeacherStudent[] @relation("StudentTeachers")
  user               User?            @relation(fields: [userId], references: [id])
  submissions        AssignmentSubmission[]
  activities         ActivityLog[]
  scoreEntries       ScoreEntry[]

  @@unique([schoolId, studentId])
  @@index([schoolId, email])
  @@map("students")
}

model Grade {
  id              String       @id @default(uuid())
  schoolId        String
  teacherId       String
  studentId       String
  subject         String
  section         String?
  term            Term
  academicYear    String
  totalScore      Float?
  totalMaxScore   Float?
  percentage      Float?
  letterGrade     LetterGrade?
  gradePoints     Float?
  gradeLabel      String?
  gradingScaleId  String?
  remarks         String?
  isPublished   Boolean      @default(false)
  publishedAt   DateTime?
  publishedBy   String?
  createdBy     String
  updatedBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  classId       String?
  assessments   Assessment[]
  classRef      Class?       @relation("GradeClass", fields: [classId], references: [id])
  school        School       @relation(fields: [schoolId], references: [id])
  student       Student      @relation(fields: [studentId], references: [id])
  teacher       User         @relation("GradeTeacher", fields: [teacherId], references: [id])

  @@unique([schoolId, teacherId, studentId, subject, term, academicYear])
  @@map("grades")
}

model Assessment {
  id        String   @id @default(uuid())
  gradeId   String
  type      String
  title     String
  score     Float
  maxScore  Float
  weight    Float    @default(1)
  date      DateTime @default(now())
  remarks   String?
  createdAt DateTime @default(now())
  grade     Grade    @relation(fields: [gradeId], references: [id])

  @@index([gradeId])
  @@map("assessments")
}

model AssessmentPolicy {
  id          String   @id @default(uuid())
  schoolId    String
  name        String
  description String?
  caMax       Int
  examMax     Int
  total       Int
  createdByRole      String   @default("admin")  // admin | teacher
  createdByTeacherId String?
  scopedClassId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school           School  @relation(fields: [schoolId], references: [id])
  components       CAComponent[]
  assignments      PolicyAssignment[]
  createdByTeacher User?   @relation("TeacherCreatedPolicies", fields: [createdByTeacherId], references: [id])
  scopedClass      Class?  @relation(fields: [scopedClassId], references: [id])

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("assessment_policies")
}

model CAComponent {
  id        String           @id @default(uuid())
  policyId  String
  name      String
  maxScore  Int
  sortOrder Int

  policy    AssessmentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("ca_components")
}

model PolicyAssignment {
  id                 String           @id @default(uuid())
  policyId           String
  scope              String           // school | class | arm | subject | subject_class
  scopeId            String?          // UUID of scope entity (null for school)
  scopeName          String?
  secondaryScopeId   String?          // classId when scope = subject_class
  secondaryScopeName String?

  policy             AssessmentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, scope, scopeId, secondaryScopeId])
  @@index([policyId])
  @@map("policy_assignments")
}

model TeacherPolicyPermission {
  id        String   @id @default(uuid())
  teacherId String
  classId   String
  grantedBy String
  grantedAt DateTime @default(now())

  teacher User  @relation("TeacherPermission", fields: [teacherId], references: [id])
  class   Class @relation(fields: [classId], references: [id])
  granter User  @relation("GrantedByAdmin", fields: [grantedBy], references: [id])

  @@unique([teacherId, classId])
  @@map("teacher_policy_permissions")
}

model ScoreSheet {
  id          String   @id @default(uuid())
  schoolId    String
  teacherId   String
  classId     String
  subjectId   String
  termId      String
  status      String   @default("draft")
  returnNote  String?
  submittedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries ScoreEntry[]
  school  School @relation(fields: [schoolId], references: [id])
  teacher User   @relation("TeacherScoreSheets", fields: [teacherId], references: [id])
  class   Class  @relation(fields: [classId], references: [id])

  @@unique([teacherId, classId, subjectId, termId])
  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@index([termId])
  @@map("score_sheets")
}

model ScoreEntry {
  id        String @id @default(uuid())
  sheetId   String
  studentId String
  caScores  Json
  examScore Float?

  sheet   ScoreSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id])

  @@unique([sheetId, studentId])
  @@index([sheetId])
  @@map("score_entries")
}

model OTP {
  id            String    @id @default(uuid())
  email         String
  otp           String
  purpose       String
  schoolId      String?
  userId        String?
  expiresAt     DateTime
  isUsed        Boolean   @default(false)
  usedAt        DateTime?
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(3)
  createdFromIP String?
  usedFromIP    String?
  createdAt     DateTime  @default(now())

  @@index([email, purpose])
  @@map("otps")
}

model Invitation {
  id         String    @id @default(uuid())
  schoolId   String
  email      String
  role       String
  token      String    @unique
  status     String    @default("pending")
  invitedBy  String?
  acceptedBy String?
  acceptedAt DateTime?
  expiresAt  DateTime
  firstName  String?
  lastName   String?
  phone      String?
  classes    String[]
  subjects   String[]
  message    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([schoolId, email])
  @@map("invitations")
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  relation  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  parent    User     @relation("ParentStudents", fields: [parentId], references: [id])
  student   Student  @relation("StudentParents", fields: [studentId], references: [id])

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@map("parent_students")
}

model TeacherStudent {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  subject   String?
  class     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  student   Student  @relation("StudentTeachers", fields: [studentId], references: [id])
  teacher   User     @relation("TeacherStudents", fields: [teacherId], references: [id])

  @@unique([teacherId, studentId])
  @@index([teacherId])
  @@index([studentId])
  @@map("teacher_students")
}

model Class {
  id        String         @id @default(uuid())
  schoolId  String
  name      String
  baseLevel String?
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  level     Int?
  arms                Arm[]               @relation("ClassArms")
  subjects            ClassSubject[]
  school              School              @relation(fields: [schoolId], references: [id])
  grades              Grade[]             @relation("GradeClass")
  students            Student[]           @relation("StudentClass")
  attendanceSessions  AttendanceSession[]
  scoreSheets             ScoreSheet[]
  feeStructures           FeeStructure[]
  assessmentPolicies      AssessmentPolicy[]
  teacherPolicyPermissions TeacherPolicyPermission[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([baseLevel])
  @@map("classes")
}

model Subject {
  id            String         @id @default(uuid())
  schoolId      String
  name          String
  code          String
  description   String?
  category      String         @default("core")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  armSubjects   ArmSubject[]
  classSubjects ClassSubject[]
  school        School         @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, code])
  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([category])
  @@map("subjects")
}

model Arm {
  id             String       @id @default(uuid())
  schoolId       String
  classId        String
  name           String
  classTeacherId String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  armSubjects        ArmSubject[]
  class              Class               @relation("ClassArms", fields: [classId], references: [id])
  classTeacher       User?                @relation("ArmClassTeacher", fields: [classTeacherId], references: [id])
  school             School              @relation(fields: [schoolId], references: [id])
  students           Student[]           @relation("ArmStudents")
  attendanceSessions AttendanceSession[]
  feeStructures      FeeStructure[]

  @@unique([schoolId, classId, name])
  @@index([schoolId])
  @@index([classId])
  @@map("arms")
}

model ArmSubject {
  id        String   @id @default(uuid())
  armId     String
  subjectId String
  createdAt DateTime @default(now())
  arm       Arm      @relation(fields: [armId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([armId, subjectId])
  @@index([armId])
  @@index([subjectId])
  @@map("arm_subjects")
}

model ClassSubject {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model SystemAlert {
  id            String    @id @default(uuid())
  type          String
  title         String
  message       String
  schoolId      String?
  isRead        Boolean   @default(false)
  isGlobal      Boolean   @default(false)
  relatedEntity String?
  entityType    String?
  createdBy     String?
  readBy        String[]
  readAt        DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([schoolId])
  @@index([type])
  @@map("system_alerts")
}

model PlatformAuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  schoolId   String?
  userId     String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())
  school     School?  @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([userId])
  @@index([action])
  @@map("platform_audit_logs")
}

model SystemConfiguration {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configurations")
}

// =============== ACADEMIC CALENDAR MODELS ===============

model AcademicYear {
  id        String   @id @default(uuid())
  schoolId  String
  year      String // e.g., "2023-2024"
  name      String? // e.g., "2023/2024 Academic Year"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  // Relations
  school             School              @relation(fields: [schoolId], references: [id])
  terms              AcademicTerm[]
  calendarEvents     SchoolCalendar[]
  attendanceSessions AttendanceSession[]
  feeInvoices        FeeInvoice[]

  @@unique([schoolId, year])
  @@index([schoolId])
  @@index([isCurrent])
  @@map("academic_years")
}

model AcademicTerm {
  id             String   @id @default(uuid())
  schoolId       String
  academicYearId String
  name           String // e.g., "First Term", "Second Term"
  term           Term // enum: First_Term, Second_Term, Third_Term
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  isCurrent      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt()

  // Relations
  school             School              @relation(fields: [schoolId], references: [id])
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  calendarEvents     SchoolCalendar[]
  attendanceSessions AttendanceSession[]
  feeInvoices        FeeInvoice[]

  @@unique([schoolId, academicYearId, term])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([isCurrent])
  @@map("academic_terms")
}

model SchoolCalendar {
  id             String    @id @default(uuid())
  schoolId       String
  academicYearId String?
  academicTermId String?
  eventType      String // holiday, exam, event, etc.
  title          String
  description    String?
  startDate      DateTime
  endDate        DateTime?
  isAllDay       Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt()

  // Relations
  school             School              @relation(fields: [schoolId], references: [id])
  academicYear       AcademicYear?       @relation(fields: [academicYearId], references: [id])
  academicTerm       AcademicTerm?       @relation(fields: [academicTermId], references: [id])
  attendanceSessions AttendanceSession[]

  @@index([schoolId])
  @@index([academicYearId])
  @@index([academicTermId])
  @@index([eventType])
  @@index([startDate])
  @@map("school_calendar")
}

// =============== ATTENDANCE MODELS ===============

model AttendanceSession {
  id             String    @id @default(uuid())
  schoolId       String
  academicYearId String?
  academicTermId String?
  classId        String?
  armId          String?
  subjectId      String?
  periodId       String?
  periodNumber   Int?
  scheduleId     String?
  status         String    @default("draft")
  date           DateTime
  sessionType    String // "morning", "afternoon", "full_day"
  startTime      DateTime?
  endTime        DateTime?
  isActive       Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt()

  // Relations
  school       School             @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear?      @relation(fields: [academicYearId], references: [id])
  academicTerm AcademicTerm?      @relation(fields: [academicTermId], references: [id])
  class        Class?             @relation(fields: [classId], references: [id])
  arm          Arm?               @relation(fields: [armId], references: [id])
  creator      User               @relation("AttendanceSessionCreator", fields: [createdBy], references: [id])
  events       SchoolCalendar[]
  records      AttendanceRecord[]

  @@unique([schoolId, classId, armId, date, sessionType])
  @@index([schoolId])
  @@index([date])
  @@index([classId])
  @@index([armId])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  sessionId String
  studentId String
  status    String // "present", "absent", "late", "excused"
  remarks   String?
  markedBy  String
  markedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()

  // Relations
  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  marker  User              @relation("AttendanceMarker", fields: [markedBy], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@map("attendance_records")
}

// =============== FEES MODELS ===============

model FeeStructure {
  id               String   @id @default(uuid())
  schoolId         String
  academicYearId   String?
  termId           String?
  classId          String?
  armId            String?
  name             String
  items            Json     // [{feeType, name, amount (Int, kobo), optional}]
  totalAmount      Int      // sum of all item amounts in kobo
  dueDate          DateTime
  paymentType      String   @default("one-time") // "one-time" | "installment"
  installmentPlans Json?    // [{label, percentage, dueDate}] — percentages must sum to 100
  status           String   @default("draft") // "draft" | "published"
  version          Int      @default(1)
  isActive         Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()

  school School @relation(fields: [schoolId], references: [id])
  class  Class? @relation(fields: [classId], references: [id])
  arm    Arm?   @relation(fields: [armId], references: [id])
  creator User @relation("FeeStructureCreator", fields: [createdBy], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([academicYearId])
  @@index([classId])
  @@map("fee_structures")
}

model FeeStructureVersion {
  id             String   @id @default(uuid())
  feeStructureId String
  version        Int
  snapshot       Json     // full fee structure at that version
  changedBy      String
  changedAt      DateTime @default(now())

  @@unique([feeStructureId, version])
  @@index([feeStructureId])
  @@map("fee_structure_versions")
}

model FeeInvoice {
  id               String   @id @default(uuid())
  schoolId         String
  studentId        String
  studentName      String?
  className        String?
  feeStructureId   String
  feeStructureName String?
  invoiceNumber    String   @unique
  amount           Int      // total billed in kobo
  amountPaid       Int      @default(0)
  amountDue        Int
  dueDate          DateTime
  status           String   @default("pending") // "pending" | "partial" | "paid" | "overdue" | "void"
  academicYearId   String?
  termId           String?
  isActive         Boolean  @default(true)
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()

  school       School        @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  term         AcademicTerm? @relation(fields: [termId], references: [id])
  creator      User          @relation("FeeInvoiceCreator", fields: [createdBy], references: [id])

  @@unique([schoolId, invoiceNumber])
  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
  @@map("fee_invoices")
}

model FeePayment {
  id               String   @id @default(uuid())
  schoolId         String
  invoiceId        String
  amount           Int      // in kobo
  paymentMethod    String   // "cash" | "bank_transfer" | "pos" | "cheque" | "card" | "mobile_money"
  gateway          String?  // "paystack" | "flutterwave"
  gatewayReference String?
  authorizationUrl String?
  accessCode       String?
  referenceNumber  String?
  receiptNumber    String?  @unique
  note             String?
  status           String   @default("pending") // "pending" | "confirmed" | "failed"
  paidAt           DateTime?
  receivedBy       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt()

  school   School @relation(fields: [schoolId], references: [id])
  receiver User   @relation("FeePaymentReceiver", fields: [receivedBy], references: [id])

  @@index([schoolId])
  @@index([invoiceId])
  @@index([status])
  @@index([paidAt])
  @@map("fee_payments")
}

model FeeAdjustment {
  id         String   @id @default(uuid())
  schoolId   String
  studentId  String
  invoiceId  String?
  type       String   // "discount" | "waiver" | "scholarship" | "correction"
  amount     Int      // in kobo (positive = reduction)
  reason     String
  approvedBy String
  createdAt  DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([type])
  @@map("fee_adjustments")
}

model FeeLedgerEntry {
  id          String   @id @default(uuid())
  schoolId    String
  studentId   String
  type        String   // "debit" | "credit" | "adjustment"
  amount      Int      // in kobo
  balance     Int      // running balance (kobo)
  description String
  reference   String?  // invoiceId / paymentId / adjustmentId
  account     String   @default("receivable") // "receivable" | "revenue"
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([studentId])
  @@index([entryDate])
  @@map("fee_ledger_entries")
}

model FeeReceipt {
  id            String   @id @default(uuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  schoolInfo    Json     // {name, logoUrl, address}
  studentInfo   Json     // {name, className}
  items         Json     // [{name, amount}]
  amountPaid    Int
  balance       Int
  method        String
  reference     String?
  paidAt        DateTime
  issuedBy      String
  createdAt     DateTime @default(now())

  @@map("fee_receipts")
}

model FeeReconciliation {
  id           String    @id @default(uuid())
  schoolId     String
  settlementId String
  gateway      String    // "paystack" | "flutterwave"
  amount       Int
  settledAt    DateTime
  paymentId    String?
  status       String    @default("unmatched") // "matched" | "unmatched"
  matchedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([schoolId])
  @@index([status])
  @@map("fee_reconciliations")
}

// =============== EVENTS & NOTIFICATIONS MODELS ===============

model Event {
  id                   String              @id @default(uuid())
  schoolId             String
  termId               String
  name                 String
  date                 DateTime
  endDate              DateTime?
  type                 String              // holiday | exam | event
  notificationConfigId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  notificationConfig NotificationConfig?
  notificationLogs   NotificationLog[]

  @@index([schoolId])
  @@index([termId])
  @@index([type])
  @@map("events")
}

model NotificationConfig {
  id        String   @id @default(uuid())
  eventId   String   @unique
  targets   Json     // { roles: [], classIds: [], userIds: [] }
  channels  Json     // ["push", "sms", "email", "in_app"]
  schedule  Json     // { type: "immediate|scheduled", sendAt: "ISO8601|null" }
  status    String   @default("draft") // draft | scheduled | processing | sent | failed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("notification_configs")
}

model NotificationLog {
  id            String    @id @default(uuid())
  eventId       String
  recipientId   String
  recipientName String
  channel       String    // push | sms | email | in_app
  status        String    // sent | failed | pending
  sentAt        DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([status])
  @@map("notification_logs")
}

// =============== TIMETABLE MODELS ===============

model TimetableDraft {
  id              String   @id @default(uuid())
  schoolId        String
  classId         String
  termId          String
  academicYearId  String?
  armId           String?
  periods         Json
  schedules       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([classId, termId, armId])
  @@index([schoolId])
  @@map("timetable_drafts")
}

model TimetablePublished {
  id              String   @id @default(uuid())
  schoolId        String
  classId         String
  termId          String
  academicYearId  String?
  armId           String?
  periods         Json
  schedules       Json
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([classId, termId, armId])
  @@index([schoolId])
  @@index([termId])
  @@map("timetable_published")
}

// =============== ASSIGNMENT & SUBMISSION MODELS ===============

model Assignment {
  id            String                 @id @default(uuid())
  schoolId      String
  classId       String?
  armId         String?
  subject       String
  termId        String?
  teacherId     String
  title         String
  description   String?
  dueAt         DateTime
  maxScore      Float                  @default(100)
  attachments   Json?
  isPublished   Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  submissions   AssignmentSubmission[]

  @@index([schoolId, dueAt])
  @@index([schoolId, classId])
  @@map("assignments")
}

model AssignmentSubmission {
  id             String     @id @default(uuid())
  assignmentId   String
  studentId      String
  textResponse   String?
  attachments    Json?
  submittedAt    DateTime   @default(now())
  status         String     @default("submitted")
  gradePercent   Float?
  feedback       String?
  gradedAt       DateTime?
  gradedById     String?

  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@map("assignment_submissions")
}

// =============== NOTIFICATION & ACTIVITY MODELS ===============

model Notification {
  id          String   @id @default(uuid())
  schoolId    String
  userId      String
  type        String
  title       String
  body        String?
  isRead      Boolean  @default(false)
  meta        Json?
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([schoolId, userId])
  @@index([schoolId, userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(uuid())
  studentId   String
  type        String
  description String
  timestamp   DateTime @default(now())
  meta        Json?

  student     Student  @relation(fields: [studentId], references: [id])

  @@index([studentId, timestamp])
  @@map("activity_logs")
}

enum UserRole {
  admin
  teacher
  parent
  student
}

enum Gender {
  male
  female
  other
}

enum Term {
  First_Term
  Second_Term
  Third_Term
}

enum LetterGrade {
  A_plus
  A
  A_minus
  B_plus
  B
  B_minus
  C_plus
  C
  C_minus
  D_plus
  D
  F
}

// =============== RESULT PUBLISHING MODELS ===============

model ResultPublication {
  id          String   @id @default(uuid())
  schoolId    String
  termId      String
  classId     String
  published   Boolean  @default(false)
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, termId, classId])
  @@index([schoolId])
  @@map("result_publications")
}

model PdfJob {
  id          String   @id @default(uuid())
  schoolId    String
  type        String   // "results" | "report_card"
  status      String   @default("processing") // processing | completed | failed
  progress    Int      @default(0)
  downloadUrl String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@map("pdf_jobs")
}

// =============== REPORT CARD MODELS ===============

model ReportCardTemplate {
  id          String   @id @default(uuid())
  schoolId    String   @unique
  orientation String   @default("portrait") // portrait | landscape
  accent      String   @default("blue") // blue | green | purple | amber | slate
  blocks      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("report_card_templates")
}

model ReportCardComment {
  id        String   @id @default(uuid())
  schoolId  String
  studentId String
  armId     String
  termId    String
  comment   String?
  traits    Json?
  status    String   @default("pending") // pending | completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, armId, termId])
  @@index([schoolId])
  @@index([armId, termId])
  @@map("report_card_comments")
}

model ReportCardPublication {
  id              String    @id @default(uuid())
  schoolId        String
  armId           String
  termId          String
  signedOff       Boolean   @default(false)
  signedAt        DateTime?
  signedBy        String?
  released        Boolean   @default(false)
  releasedAt      DateTime?
  releasedBy      String?
  publishedCount  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([schoolId, armId, termId])
  @@index([schoolId])
  @@map("report_card_publications")
}
